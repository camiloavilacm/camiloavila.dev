  "PortfolioApi": {
   "Type": "AWS::Serverless::HttpApi",
   "Properties": {
    "StageName": "prod",
    "Description": "HTTP API for camiloavila.dev portfolio",
    "CorsConfiguration": {
     "AllowOrigins": [
      "https://camiloavila.dev",
      "http://localhost:5173"
     ],
     "AllowMethods": [
      "POST",
      "OPTIONS"
     ],
     "AllowHeaders": [
      "Content-Type"
     ],
     "MaxAge": 300
    }
   },
   "Metadata": {
    "aws:cdk:path": "camiloavila-portfolio/PortfolioApi"
   }
  },
  "ChatbotFunction": {
   "Type": "AWS::Serverless::Function",
   "Properties": {
    "FunctionName": "camiloavila-chatbot-staging",
    "CodeUri": "../../backend/src/",
    "Handler": "handler.lambda_handler",
    "Role": {
     "Fn::GetAtt": [
      "ChatbotFunctionRoleCC00CB4C",
      "Arn"
     ]
    },
    "Runtime": "python3.13",
    "Timeout": 30,
    "MemorySize": 256,
    "Tracing": "Active",
    "Description": "RAG chatbot backed by Amazon Bedrock.",
    "Environment": {
     "Variables": {
      "KNOWLEDGE_BUCKET": {
       "Ref": "KnowledgeBaseBucketC011DD60"
      },
      "KNOWLEDGE_KEY": "knowledge_base.md",
      "BEDROCK_MODEL_ID": "amazon.nova-lite-v1:0",
      "ALLOWED_ORIGIN": "https://camiloavila.dev"
     }
    },
    "Events": {
     "ChatPost": {
      "Type": "HttpApi",
      "Properties": {
       "ApiId": {
        "Ref": "PortfolioApi"
       },
       "Path": "/chat",
       "Method": "POST"
      }
     },
     "ChatOptions": {
      "Type": "HttpApi",
      "Properties": {
       "ApiId": {
        "Ref": "PortfolioApi"
       },
       "Path": "/chat",
       "Method": "OPTIONS"
      }
     }
    }
   },
   "DependsOn": [
    "ChatbotFunctionRoleCC00CB4C"
   ],
   "Metadata": {
    "aws:cdk:path": "camiloavila-portfolio/ChatbotFunction"
   }
  },
